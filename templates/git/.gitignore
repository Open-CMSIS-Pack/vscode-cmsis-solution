# Python
.venv/
__pycache__/
*.pyc
*.bak

# The exported ExecuTorch program. create_ai_layer.py writes it next to the
# generated AI layer; the C array in ai_layer/model_pte.c is what gets built.
*.pte

# CMSIS-Toolbox build outputs. RTE/ is tracked in full: the layers' configuration
# files and the per-context RTE/_<build>_<target>/ headers the toolbox writes.
out/
tmp/

# Update config files must be merged before commit
*.update@*

# cbuild output files
*.cbuild.yml
*.cbuild-idx.yml
*.cbuild-run.yml
*.cbuild-set.yml
*.cbuild-mlops.yml
*.cbuild-pack.yml
tools-environment.yml

# .vscode JSON and debug adapter files generated by CMSIS Solution even if opened in a subfolder
**/.vscode/cmsis.json
**/.vscode/launch.json
**/.vscode/tasks.json
**/.vscode/settings.json
.cmd.jlink

# Exception for line 2: "*.d"
# CMSIS Solution drop-ins are user managed source files, despite the directory suffix ".d" 
!.vscode.d/

# Object files
*.o
*.ko
*.obj

# Linker output
*.elf
*.ilk
*.map
*.exp

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Executables and images
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# Regenerated by the CMSIS Solution / clangd extensions on every build, with
# absolute paths for the machine that built it -- so it cannot be committed in
# a portable form. Not committing it loses nothing: it is generated for you.
.clangd

# FVP output captured by CI and by the manual run in the README
fvp_stdout.log

# Editor config. The CMSIS Solution extension regenerates tasks.json,
# settings.json, cmsis.json and launch.json; only the macOS FVP wiring is kept:
# the model shim + its Dockerfile, and launch.json.mac, an Arm-FVP launch
# config that waits for the model in Docker (see the comment in it). The
# leading negation overrides a global excludes file that ignores every .vscode
# directory.
!.vscode/
.vscode/*
!.vscode/fvp.sh
!.vscode/fvp.Dockerfile
!.vscode/launch.json.mac
