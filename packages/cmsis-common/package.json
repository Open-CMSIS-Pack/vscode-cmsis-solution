{
  "name": "@open-cmsis-pack/cmsis-common",
  "version": "0.1.0",
  "description": "Shared foundations and CMSIS file-model APIs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-CMSIS-Pack/vscode-cmsis-solution.git",
    "directory": "packages/cmsis-common"
  },
  "engines": {
    "node": "^22.22.0",
    "npm": "^10.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "jest --config jest.config.js --passWithNoTests"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "lodash": "^4.18.1",
    "sax-ts": "^1.2.13",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.15",
    "dedent": "1.7.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}